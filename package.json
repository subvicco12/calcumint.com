{
  "name": "calcumint",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:launch": "vitest run src/calculators/launch-portfolio.test.ts src/lib/launch/readiness.test.ts src/lib/launch/hardening.test.ts",
    "test:watch": "vitest",
    "test:certification": "vitest run src/calculators/launch-certification.test.ts src/calculators/rule-packs.test.ts",
    "test:production": "npm run lint && npm run typecheck && npm test && npm run test:launch && npm run test:certification && npm run build",
    "growthos:heartbeat": "node scripts/growthos-heartbeat.mjs",
    "admin:bootstrap-owner": "node scripts/bootstrap-platform-owner.mjs",
    "admin:publication-preflight": "node scripts/publication-recovery-preflight.mjs",
    "dev:draft-preview": "node scripts/draft-preview.mjs",
    "dev:calculator-review": "node scripts/draft-preview.mjs --catalog",
    "test:final-reference-browser": "node scripts/test-final-reference-browser.mjs",
    "test:draft-preview-browser": "node scripts/test-draft-preview-browser.mjs",
    "test:draft-persistence-postgres": "node tests/draft-preview/persistence.postgres.mjs",
    "test:authenticated-draft-browser": "node scripts/test-authenticated-draft-browser.mjs",
    "test:atomic-history-postgres": "node tests/draft-preview/atomic-history.postgres.mjs",
    "test:draft-pagination-browser": "node scripts/test-draft-pagination-browser.mjs",
    "test:migration-contract": "node --test tests/migration-contract/inventory.test.mjs && node tests/migration-contract/combined.postgres.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "clsx": "^2.1.1",
    "decimal.js": "10.6.0",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.13",
    "@tailwindcss/postcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vite": "7.3.7"
  }
}
