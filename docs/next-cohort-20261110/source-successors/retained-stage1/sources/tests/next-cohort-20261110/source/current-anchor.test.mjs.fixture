import {test} from 'node:test';
import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {verifyFixedCallerStageAnchor} from './current-anchor.mjs';
const capture=()=>JSON.parse(readFileSync('docs/next-cohort-20261110/source-successors/caller-capture.json'));
const checked=['tests/acceptance-closure-20261108/converter-final-source.test.mjs','tests/acceptance-closure-20261108/receipt-source-path.mjs','tests/next-cohort-20261110/source/current-caller-stage.mjs','tests/publication-workflows-20261109/source-evolution.test.mjs','tests/first-five-20261109/crossed-dependency-source.test.mjs','tests/next-cohort-20261110/source/caller-stage.test.mjs'];
test('independent new anchor accepts only the separately reviewed source capture and actual Git objects',()=>assert.equal(verifyFixedCallerStageAnchor(capture()),true));
test('coordinated plausible old guard, metadata and capture redirection is not a new authority',()=>{const c=capture();c.guardSource={path:c.guardSource.path,ref:'d416617b5c0533fe5d4d8a3f9fa5b15b9b539cbb',blob:'dcca9ed780ea0c67c3182698620107369143ac5c',sha256:'e22d64ddbaf8adb492dd1a9957d5fcc3c9f1a0b6a02291989de6e47d70442807'};c.helperSource={path:c.helperSource.path,ref:'47c1297eee9ff8e61620c29957f4d55a014614e0',blob:'aa4fe52e54d9e128746d57b9b9c67dd559efe701',sha256:'4687e8dd24f12ae54df04722559d215b40cc44b9111b3e7fa5b46a54f9ae5413'};assert.throws(()=>verifyFixedCallerStageAnchor(c,()=>Buffer.from('coordinated old source'),()=>{throw Error('Must reject before reading replacement provenance');}),/Fixed next caller capture differs/);});
test('independent current anchor rejects missing actual source provenance',()=>assert.throws(()=>verifyFixedCallerStageAnchor(capture(),readFileSync,()=>{throw Error('Missing independent next caller provenance');}),/Missing independent next caller provenance/));
for(const path of checked)test('independent anchor rejects no-op or changed protected source '+path,()=>assert.throws(()=>verifyFixedCallerStageAnchor(capture(),name=>name===path?Buffer.from('no-op bypass'):readFileSync(name)),/Fixed next caller target bytes differ/));
test('original fixed anchor is not silently replaced with a plausible different program',()=>{const path='tests/first-five-20261109/accepted-evolution-guard.mjs';assert.throws(()=>verifyFixedCallerStageAnchor(capture(),name=>name===path?Buffer.from('replacement old anchor'):readFileSync(name)),/Historical fixed source anchor changed/);});
