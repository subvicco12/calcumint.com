import json,pathlib,hashlib,csv,collections,datetime
p=pathlib.Path(__file__).parent
def read(n):return json.loads((p/n).read_text())
def write(n,d):(p/n).write_text(json.dumps(d,ensure_ascii=False,indent=2)+'\n')
def digest(x):return hashlib.sha256(json.dumps(x,ensure_ascii=False,separators=(',',':')).encode()).hexdigest()
q=read('input/registered-review-queue.json');contract={r['masterId']:r for r in read('input/contract-evidence-44.json')['rows']};cat={r['masterId']:r for r in read('catalog-blueprint-reconciliation.json')['rows']};math={r['masterId']:r for r in read('output/math-review.json')['rows']};geo={r['masterId']:r for r in read('geometry-review.json')['rows']};qa=read('qa-requirement-adjudication.json');rules={r['requirementId']:r for r in qa['requirementRules']};qp={r['masterId']:r for r in qa['perId']}
cohort1=[209,210,218,219,220,221,225,255,256,259,260,261,262,265,266,267,273,278,279,280]
cohort2=[208,211,212,213,215,216,228,229,263,264,269,270,271,272]
cohort3=[223,224,226,227,231,234,230,217,214,268]
order=cohort1+cohort2+cohort3;assert len(order)==44 and set(order)=={r['masterId'] for r in q['rows']}
scope_ids={'identity-version','canonical-identity-version-approval','canonical-input-output-feature-scope','inherited-canonical-requirement-1','inherited-canonical-requirement-2'}
crosswalk=[];dispositions=[];register=[]
for row in q['rows']:
 i=row['masterId'];cr=contract[i];candidate=cr['registeredCandidates'][0];domain=math.get(i,geo.get(i));rank=order.index(i)+1;wave=1 if i in cohort1 else 2 if i in cohort2 else 3
 refs=[]
 for j,req in enumerate(row['unmetRequirements']):
  rid=req['requirementId'];rule=rules[rid];primary='MISSING_ACCEPTANCE_EVIDENCE';note='Existing bounded software/fixtures do not establish complete version-bound acceptance. Perform the specified per-ID checks; do not infer missing software from UNKNOWN.'
  if rid in scope_ids:primary='CANONICAL_SCOPE_OR_MAPPING_DECISION';note='Approve exact ID/engine/version/route and complete inputs, outputs, units, domain and feature applicability. Sources settle mathematical identities; approval cannot change those facts.'
  elif rid=='source-publisher-and-applicability':primary='SOURCE_EVIDENCE_GAP';note='Self-review source label is not a verified publisher reference. Bind competent mathematics review to the exact formula/domain/precision and retained authentic source clauses.'
  elif rid=='qualified-review':primary='COMPETENT_REVIEW_AND_APPLICABILITY_SCREENING';note='Obtain version-bound mathematics/numerical competence and risk/obligation disposition. No automatic specialist exemption and no invented clinical/financial certification requirement.'
  elif rid=='charts':primary='FEATURE_APPLICABILITY_DECISION';note='No visualization in inspected LaunchTool/Result path. Blueprint makes useful visualization conditional on benefit; decide per-ID appropriate visual before calling absence a mandatory implementation gap. No blanket N/A.'
  elif rid=='canonical-product-acceptance':primary='LIFECYCLE_AUTHORITY_GATE';note='Full acceptance depends on unresolved scope/evidence/review/software gates and separate authorized certification/publication. Legacy published/certified observations do not close it.'
  if i==268 and rid=='full-domain-numerical-acceptance':primary='DEMONSTRATED_SOFTWARE_DEFECT';note='Exact pinned polygon arithmetic returns Infinity for sides3/side1e154 although true result is finite. Isolated expression reproduction; fix proposal and independent actual-engine regression required.'
  if i==214 and rid=='goldens-and-rounding':primary='DECLARED_METHOD_IMPLEMENTATION_ALIGNMENT';note='Precision0, decimal0.4999999999999999 yields declared0 versus EPSILON implementation1. Canonical rounding semantics unapproved; align reviewed method/text/implementation through controlled version policy, not a guessed numerical correction.'
  inherited=None
  if rid.startswith('inherited-canonical-requirement-'):
   k=int(rid.rsplit('-',1)[1])-1;payload=cr['retainedCanonicalRequirements'][k];actual=digest(payload);expected=req['evidence'][0]['sha256'];assert actual==expected
   inherited={'payload':payload,'sourcePointer':req['evidence'][0]['path'],'expectedSHA256':expected,'recomputedJSONPayloadSHA256':actual,'hashMatches':True,'semanticOverlap':'Retained separately; overlaps canonical scope/mapping or full-domain QA requirements. Not25 independent missing software features.'};crosswalk.append({'masterId':i,'requirementId':rid,**inherited})
  rec={'masterId':i,'engineId':row['engineId'],'version':row['version'],'requirementOrdinal':j+1,'requirementId':rid,'originalRequirement':req,'originalRequirementSHA256':digest(req),'retainedStatus':req['status'],'disposition':primary,'finding':note,'existingEvidenceExtent':rule['existingEvidenceExtent'],'exactNextAction':rule['dispositionRule'],'ruleReference':'qa-requirement-adjudication.json#/requirementRules/'+str(list(rules).index(rid)),'perIdException':qp[i]['exceptionAndScopeDecision'],'inheritedEvidenceCrosswalk':inherited,'closed':False,'statusPromoted':False,'notApplicableGranted':False,'releaseHold':True}
  dispositions.append(rec);refs.append({'requirementId':rid,'disposition':primary,'ordinal':j+1})
 rank_reason='One clearly described scalar operation/shape with small ordinary-mode surface and no demonstrated cohort-specific defect or catalog presentation conflict; all shared release gates still apply.' if wave==1 else 'Broader title/output semantics, integer algorithms or transcendental/solid precision require additional focused contract/test work; no full release acceptance inferred.' if wave==2 else 'Unresolved domain/rounding semantics, specific catalog conflict or demonstrated mismatch/defect merits later controlled review.'
 register.append({'masterId':i,'title':row['title'],'category':cat[i]['catalogFields'],'catalogEvidence':cat[i],'engineId':row['engineId'],'version':row['version'],'slug':row['slug'],'candidateIdentity':row['observedCandidate'],'immutableVersionRequirements':{'baselineSHA':'af94b00cee5e8ef53e2b6ecdf1501c6b45cbaee5','engineSource':'src/calculators/launch-portfolio.ts','engineGitBlob':'ca42438b0193ca6ecc205f4bbab748eef0772881','engineSourceSHA256':'dfb7ffe1547cf96f7608a11e3ef03a95cc8186ce91760dc3bf8754995cff868f','currentVersion':1,'canonicalMappingApproved':False,'requirements':['Accountable approval of exact catalogID to engineID/version/route; no alias-based approval.','Freeze schema, formula, domain, rounding, dependencies, presentation/export semantics and applicable source/contract hashes.','Changed mathematical/domain/rounding behavior requires a controlled immutable technical successor; never mutate saved historical v1 meaning or fall back to latest.','Shared caller/UI changes remain separately SHA-bound; do not transfer unregistered statistics/six-contract successors to this cohort.']},'observedInputSchema':candidate['inputStructuralProjection'],'observedFormulas':candidate['methodology']['formulas'],'observedOutputKeys':candidate['declaredOutputKeys'],'observedScopeReview':domain,'canonicalScopeStatus':'PROPOSED_REVIEW_REQUIRED_NOT_APPROVED','sharedBlueprintRequirementsRef':'catalog-blueprint-reconciliation.json#/sharedRequirements','sourceAndReviewRestrictions':row['sourceAndReviewRestrictions'],'numericalEvidence':row['numericalEvidence'],'ranking':{'rank':rank,'proposedReviewWave':wave,'reason':rank_reason,'method':'Qualitative dependency review, not a certified simplicity score or completed-blocker count','retainedRequirementSlots':25},'newFindings':[rec for rec in refs if rec['disposition'] in ['DEMONSTRATED_SOFTWARE_DEFECT','DECLARED_METHOD_IMPLEMENTATION_ALIGNMENT']],'requirementDispositions':refs,'canonicalMappingApproved':False,'canonicalAccepted':False,'fullContractReady':False,'publicationEligible':False,'activationAuthorized':False,'readiness':'PARTIAL_REVIEWABLE_CANDIDATE_NOT_PUBLICATION_READY','releaseHold':True})
register.sort(key=lambda x:x['ranking']['rank']);counts=dict(collections.Counter(d['disposition'] for d in dispositions));status=dict(collections.Counter(d['retainedStatus'] for d in dispositions))
write('publication-readiness-register-44.json',{'baselinePR':1520,'baselineSHA':'af94b00cee5e8ef53e2b6ecdf1501c6b45cbaee5','reviewDateIST':'2026-11-03','scope':'44 candidates only; no new540-wide audit','summary':{'candidates':44,'retainedRequirements':1100,'genuinelyCompleteFullProductCohort':0,'publicationEligible':0,'firstProposedReviewCohort':20,'dispositions':counts,'baselineStatuses':status},'rankingLimit':'All44 retain25entries and shared incomplete gates. Review waves prioritize likely tractable complete contracts; no wave is authorized for publication. There is no proved globally largest releasable subset.','rows':register,'releaseHold':True})
write('requirement-dispositions-1100.json',{'baselineUnchanged':True,'counts':counts,'retainedStatuses':status,'entries':dispositions,'closed':0,'releaseHold':True})
write('inherited-requirement-crosswalk-176.json',{'count':len(crosswalk),'allHashMatches':True,'rows':crosswalk})
with (p/'requirement-dispositions-1100.csv').open('w') as f:
 cols=['masterId','engineId','version','requirementOrdinal','requirementId','retainedStatus','disposition','finding','exactNextAction','originalRequirementSHA256','closed'];w=csv.DictWriter(f,fieldnames=cols);w.writeheader();w.writerows({k:r[k] for k in cols} for r in dispositions)
with (p/'ranked-publication-candidates-44.csv').open('w') as f:
 cols=['rank','proposedReviewWave','masterId','title','engineId','version','retainedRequirements','publicationEligible','finding'];w=csv.DictWriter(f,fieldnames=cols);w.writeheader()
 for r in register:w.writerow({'rank':r['ranking']['rank'],'proposedReviewWave':r['ranking']['proposedReviewWave'],'masterId':r['masterId'],'title':r['title'],'engineId':r['engineId'],'version':r['version'],'retainedRequirements':25,'publicationEligible':False,'finding':r['ranking']['reason']})
write('ranked-review-cohorts.json',{'method':'Dependencies and canonical ambiguity; not passing-test count','approvedReleaseCohort':[],'completeFullProductCohort':[],'wave1':cohort1,'wave2':cohort2,'wave3':cohort3,'allRequireSharedGates':True,'releaseHold':True})
print(json.dumps({'dispositionCounts':counts,'retainedStatusCounts':status,'entries':len(dispositions),'inheritedHashMatches':len(crosswalk),'proposedWaveSizes':[len(cohort1),len(cohort2),len(cohort3)]},indent=2))
