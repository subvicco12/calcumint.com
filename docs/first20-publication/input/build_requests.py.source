import json,pathlib,hashlib
p=pathlib.Path(__file__).parent
def read(n):return json.loads((p/n).read_text())
def write(n,d):(p/n).write_text(json.dumps(d,ensure_ascii=False,indent=2)+'\n')
reg=read('publication-readiness-register-44.json')['rows'];ids=sorted(r['masterId'] for r in reg);geo=[i for i in ids if i>=255];math=[i for i in ids if i<255]
choices=[
 {'id':'OC44-01','catalogIds':[211,212,213,215,216,217,229,231],'question':'Set complete meaning/modes for broad catalog titles; retain catalog functionality rather than silently accepting the small current scalar scope.','proposedDecision':'Document Ratio simplification versus quotient, Proportion missing-term solving versus ratio, Fraction operations versus one division, Average dataset cardinality versus two values, Weighted Average selectable weights versus fixed1:2, Factor all factors versus smallest factor, Scientific Notation normalized representation versus scaling. Existing scalar definitions remain historical v1.','consequence':'Additional required modes/outputs become separately approved technical successor work; passing existing scalar fixtures cannot complete those broader contracts.','sourceDoesNotSettle':'A mathematical identity does not decide the product modes implied by a broad title or allocate a catalog identity.'},
 {'id':'OC44-02','catalogIds':[208,209,210,211,212,213,215,225,226,234],'question':'Select explicitly named sign/domain semantics and error cases where multiple mathematical conventions exist.','proposedDecision':'Keep absolute-old percentage-change convention labeled; explicitly decide negative originals, decrease above100%, truncating signed remainder versus Euclidean modulus, denominator zero, and whether Percent Error accepts any nonzero signed reference or the current positive cutoff. Require sourced naming and separate mode names where conventions differ.','consequence':'Selected domains affect validation, labels and goldens. Sources settle arithmetic within a chosen convention; owner choice cannot legitimize a contradictory equation.','sourceDoesNotSettle':'Product audience/domain and intended convention, not underlying arithmetic.'},
 {'id':'OC44-03','catalogIds':[214,230,231],'question':'Select decimal rounding and representation contract, precision limits and display/replay meaning.','proposedDecision':'Obtain competent numerical review of exact decimal versus binary64 rounding, tie mode, signed zero and scientific-notation normalization. Do not adopt Number.EPSILON adjustment as an authoritative rule merely because fixtures pass. Align214 text and implementation only after deciding the intended contract.','consequence':'Any changed numeric/domain behavior requires controlled immutable successor and recertification evidence; no silent mutation of v1 snapshots.','sourceDoesNotSettle':'The desired product precision envelope, supported input forms and display choices; published rounding conventions must be named accurately.'},
 {'id':'OC44-04','catalogIds':ids,'question':'Declare supported numeric envelope, accuracy budget and presentation precision without weakening canonical promised functionality.','proposedDecision':'Use domain-reviewed finite-range/accuracy limits and explicit approximation/unsupported outcomes. Reconcile generic12fractional-digit Result rendering with raw tiny/large outputs; do not transfer the unregistered full-six12/15significant half-even policy to44 by implication.','consequence':'Existing Number-valued engines remain v1; wider exact-decimal/rational or display contracts need controlled successor/adapters and independent expectations.','sourceDoesNotSettle':'Product supported envelope and UI precision; arithmetic/error analysis must be justified independently.'},
 {'id':'OC44-05','catalogIds':geo,'question':'Select explicit geometry input/output quantity and unit modes, zero-degenerate handling and intended variants.','proposedDecision':'Bind inputs to compatible length units and outputs to length/area/volume/angle dimensions; specify available unit selections and shape assumptions. Confirm Triangle Area base/height versus other modes and Hypotenuse255 versus Pythagorean278 identity boundaries. Formulas and unit exponents are source/reviewer facts, not owner voting choices.','consequence':'Missing approved variants/units stay tracked in full scope; no arbitrary-feature N/A or umbrella title substitution.','sourceDoesNotSettle':'Which product modes and selectable units are offered; published shape identities remain binding.'},
 {'id':'OC44-06','catalogIds':[268],'question':'Does Polygon Area require arbitrary polygon vertices as well as regular n/side mode?','proposedDecision':'Explicitly name current mode regular polygon; resolve full canonical title before acceptance. Independently fix the reproduced finite-result overflow without using a scope cap to hide it.','consequence':'If arbitrary polygons are required, coordinate order/self-intersection/hole policy and separate algorithm acceptance are new conditional tasks. A regular-only component is not silently the complete broad product.','sourceDoesNotSettle':'Catalog title alone does not select intended polygon modes.'},
 {'id':'OC44-07','catalogIds':[217],'question':'Resolve native catalog presentation mismatch for Weighted Average.','proposedDecision':'Controlled reconciliation of native Range/health, B Analytical and reference-range/history-trend profile versus mathematical weighted-mean engine. Confirm intended product and preserve original record; do not silently reclassify or add clinical claims.','consequence':'If genuinely health-related claims are intended, perform applicable clinical/YMYL screening. Otherwise document a governed catalog correction plus complete mathematical weights/dataset scope; no automatic health exemption.','sourceDoesNotSettle':'Conflicting project product metadata requires accountable resolution.'},
 {'id':'OC44-08','catalogIds':ids,'question':'Approve reasoned per-ID applicability for useful visualization, cards, reverse, scenarios/sensitivity and plan-specific workflow outputs.','proposedDecision':'Apply Blueprint and native catalog obligations. Choose useful geometric diagrams/quantity comparisons or mathematical relationship visuals where beneficial. Record reasons when conditional features are inapplicable; no blanket44 N/A. Mandatory accuracy, safety, core explanation, accessible interaction and lifecycle gates remain.','consequence':'Only applicable unimplemented features become software tasks. Global account controls being present does not prove authenticated history/scenario/export or tier-specific acceptance.','sourceDoesNotSettle':'Exact presentation design and benefit-driven conditional feature applicability; already mandated requirements are not optional.'}
]
for x in choices:x.update(status='PENDING',approvedBy=None,approvedAt=None,contractHash=None,scopeWaiver=False)
write('grouped-owner-choices.json',{'status':'PENDING_NO_NEW_APPROVALS','principle':'Owner choices only for unsettled product conventions/profile/applicability. Do not ask owner to vote on established identities, substitute for competent review or waive full scope.','choices':choices,'separateAccountableAcceptance':'Exact44 ID/engine/version/route and complete-contract acceptance remains an accountable QA/lifecycle act; matched title and registration alone do not grant it.','releaseHold':True})
requests=[]
for r in reg:
 i=r['masterId'];rv=r['observedScopeReview'];requests.append({'masterId':i,'engineId':r['engineId'],'version':1,'scope':'Complete selected canonical contract, not just default scalar expression','observedEquations':r['observedFormulas'],'sourceRequest':rv.get('sourceRequest','Retain authoritative shape/quantity/angle formula clauses with edition/page, publisher provenance, units/domain and explicit relationship to selected modes. Existing OpenStax/NIST captures are relevant partial evidence, not a per-ID acceptance decision.'),'existingSourceRestriction':r['sourceAndReviewRestrictions'],'reviewerCompetency':'Elementary/geometry mathematics and numerical software validation, including floating-point bounds, rounding and dimensional analysis; demonstrable relevant competence required, no invented paid-specialist or degree mandate.','specialistScreening':'Record actual risk and obligation findings; no automatic clinical/financial gate solely from standard-risk label. ID217 catalog conflict must be resolved before concluding applicability.' if i==217 else 'Record version-bound standard-mathematics risk/obligation disposition; do not infer exemption from UNKNOWN.','reviewDecisionFields':['reviewer identity','relevant competence/provenance','exact catalog/engine/version/fullSHA/contract/source bindings','reviewed modes and numerical envelope','exceptions and unresolved claims','decision and date'],'qaRequest':['Independently derived source/rational/high-precision examples, full selected domain and negative cases, explicit absolute/relative error budgets and display/raw reconciliation.','Actual browser route and parser/engine/action recovery for exact ID on mobile/desktop and Free/Pro/Business; classify gate denials and parity separately.','Accessible keyboard/focus/error/results/touch/reduced-motion checks; physical assistive-device acceptance only after genuine execution.','Measured representative cold/warm performance and numeric worst-case bounds; no passing build used as performance acceptance.','Real authorized non-production account saved history/replay/scenario/export bytes with exact immutable identity, ownership/tamper checks and expected entitlements; mock transport cannot prove persistence.','CSV/JSON/PDF reconcile with same engine; independently validated PDF/UA only when required and genuinely reviewed.','Accountable canonical acceptance and separate certification/publication evidence; preserve RELEASE HOLD.'],'status':'REQUESTED_EVIDENCE_NOT_OBTAINED','qualifiedApprovalObtained':False})
write('reviewer-and-source-requests-44.json',{'noOutreachPerformed':True,'rows':requests,'releaseHold':True})
tasks=[
 {'id':'CODEX44-01','catalogIds':[268],'classification':'DEMONSTRATED_SOFTWARE_DEFECT','independentlyExecutable':'Narrow correction proposal and regression specification are ready; source edits require separate engineering execution, not this read-only mission.','source':'src/calculators/launch-portfolio.ts regular polygon spec and launchDefinition finite-result wrapper','reproduction':{'input':{'sides':3,'side':1e154},'pinnedExpression':'sides*side*side/(4*Math.tan(Math.PI/sides))','observed':'Infinity; finite-result wrapper throws','independentReference':'sqrt(3)/4*(1e154)^2 = approximately4.330127018922193e307, finite','scope':'Bounded isolated expression, not end-to-end application test'},'task':'Add independent high-magnitude finite-result test and overflow-safe scaling/order; preserve truly unrepresentable rejection. Check ordinary and subnormal/large-side-count cases narrowly. Do not cap valid input solely to hide intermediate overflow.','versionRule':'Preserve v1 and saved history; apply existing controlled successor policy to any approved behavioral change.','doneWhen':'Actual mapped successor engine matches independent reference within approved tolerance; ordinary fixtures, domain failures and historical replay unchanged as required. No new publication authority.'},
 {'id':'CODEX44-02','catalogIds':[214],'classification':'DEMONSTRATED_METHOD_TEXT_ALIGNMENT_PENDING_POLICY','dependency':'OC44-03 and competent numerical method decision','task':'Reproduce decimal0.4999999999999999,p0: literal declared round(decimal*10^p)/10^p=0 versus EPSILON implementation1. Bind reviewed semantics and align formula metadata/compute/display without silently changing historical v1. Include fraction representation assertions in actual engine/display/replay evidence, not only result numeric goldens.','doNotClaim':'No canonical mathematically correct rounding policy has been approved; this is an alignment defect, not permission to delete EPSILON speculatively.'},
 {'id':'CODEX44-03','catalogIds':ids,'classification':'SCOPE_AND_EVIDENCE_PREPARATION','task':'Create exact44 contract/ID/version/route/dependency/source-SHA mapping and per-ID feature applicability proposals from this dossier; preserve immutable v1 and catalog fields including217conflict. Consolidate shared requirements without deleting any1,100records.','dependency':'Owner/reviewer choices only where unsettled; sources determine mathematical facts.'},
 {'id':'CODEX44-04','catalogIds':ids,'classification':'CONDITIONAL_UI_IMPLEMENTATION','dependency':'Approved per-ID Blueprint/catalog feature applicability and complete contract','task':'Reuse existing FinalCalculatorRenderer/result/presentation/entitlement architecture for applicable launch workflows. Current LaunchTool path only renders scalar Result+fields+account actions+AI explanation. Add approved units, meaningful visuals/cards/modes and error interpretation; do not rebuild correct engines or invent blanket charts/N_A.'},
 {'id':'CODEX44-05','catalogIds':ids,'classification':'MISSING_ACCEPTANCE_EVIDENCE_NOT_PROVEN_MISSING_SOFTWARE','task':'Execute version-bound independent actual-engine domain/rounding, plan parity, browser/action/ownership/tamper/history/scenario/export, accessibility and performance acceptance against approved contracts. Reuse existingfixtures and sharedharness; do not rerun broad540research or treat control journeys as44coverage. Implement only newly demonstrated gaps.','dependency':'Selected contracts and authorized isolated provider/accounts for genuine persistence; unavailable evidence stays blocked.'}
]
write('minimal-codex-tasks.json',{'readOnlyResearchOnly':True,'sourceChangesExecuted':False,'tasks':tasks,'releaseHold':True})
