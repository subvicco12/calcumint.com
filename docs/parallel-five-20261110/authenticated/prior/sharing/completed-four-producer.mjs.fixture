import assert from 'node:assert/strict';
import {mkdir,readFile,writeFile} from 'node:fs/promises';
import {randomUUID,createHash} from 'node:crypto';
import path from 'node:path';
import {execFileSync} from 'node:child_process';
import {recordedDownload} from '../next-runtime/recorded-download.mjs';
/** Uses the same genuine GoTrue/PostgREST and actual production Next HTTP runtime. */
export async function runSharingProof({next,db,browser,signup,cookie,cases,artifacts,pass}){
 const directory=path.join(artifacts,'sharing');await mkdir(directory+'/downloads',{recursive:true});const rows=[],downloads=[],comparisons=[],checks=[],sourceHashes={},sha=b=>createHash('sha256').update(b).digest('hex'),ok=async req=>{const r=await req;assert.equal(r.error,null,JSON.stringify(r.error));return r.data;};
 for(const file of ['src/lib/business/technology-next-sharing.ts','src/lib/business/technology-next-sharing-server.ts','src/app/api/business/technology-five-shares/route.ts','src/components/technology-five-shared-comparison.tsx','src/app/business/projects/[id]/page.tsx','src/app/business/shared/[id]/page.tsx','src/components/technology-five-share-form.tsx'])sourceHashes[file]=sha(await readFile(path.join(next.dir,file)));
 const users={};for(const role of ['owner','admin','member','viewer','foreign'])users[role]=await signup('business');
 const org=await ok(users.owner.sdk.rpc('create_business_organization',{org_name:'Five genuine shared workspace',org_slug:'parallel-'+randomUUID()}));
 await db.sql(`INSERT INTO public.organization_members(organization_id,user_id,role) VALUES('${org}','${users.admin.id}','admin'),('${org}','${users.member.id}','member'),('${org}','${users.viewer.id}','viewer');`);
 const project=await ok(users.owner.sdk.from('business_projects').insert({organization_id:org,name:'Exact five workspace',created_by:users.owner.id}).select().single());
 const client=await ok(users.owner.sdk.from('client_workspaces').insert({organization_id:org,project_id:project.id,name:'Five client',created_by:users.owner.id}).select().single());
 const post=async(user,payload)=>{const r=await fetch(next.url+'/api/business/technology-five-shares?cohort=next',{method:'POST',headers:{Cookie:cookie(user),Origin:next.url,'Content-Type':'application/json'},body:JSON.stringify(payload),signal:AbortSignal.timeout(30000)});return {status:r.status,body:await r.json()};};
 const enabled=label=>`[...document.querySelectorAll('button')].some(e=>e.textContent.trim()===${JSON.stringify(label)}&&!e.disabled&&!e.closest('[hidden],[inert]')&&e.getClientRects().length)`;
 const visit=async url=>{await browser.send('Page.navigate',{url:next.url+url});await browser.until('document.readyState==="complete"');};
 const trustedClick=async label=>{await browser.send('Page.bringToFront');await browser.until(`(()=>{const e=[...document.querySelectorAll('button')].find(e=>e.textContent.trim()===${JSON.stringify(label)});if(!e||e.disabled||e.closest('[hidden],[inert]')||!e.getClientRects().length||!Object.keys(e).some(k=>k.startsWith('__reactProps$')))return false;e.scrollIntoView({behavior:'instant',block:'center'});e.focus();return document.hasFocus()&&document.activeElement===e&&!document.body.innerText.includes('Verifying account session')})()`);for(const type of ['keyDown','keyUp'])await browser.send('Input.dispatchKeyEvent',{type,key:'Enter',code:'Enter',windowsVirtualKeyCode:13,...(type==='keyDown'?{text:'\r',unmodifiedText:'\r'}:{})});};
 const downloadBrowser={...browser,click:trustedClick};
 for(const c of cases){
  // Actual API result is re-verified by the real sharing server against original registered engine.
  const input=Object.fromEntries(Object.entries(c.input).map(([k,v])=>[k,k==='raidLevel'?v:Number(v)]));
  const output=JSON.parse(await db.sql(`SELECT output_data::text FROM public.calculation_history WHERE calculator_slug='${c.slug}' ORDER BY created_at DESC LIMIT 1;`));assert.equal(output.value,c.expected);
  const snapshot={calculatorSlug:c.slug,calculatorVersion:1,input,output};const payload={organizationId:org,projectId:project.id,clientWorkspaceId:client.id,requestId:randomUUID(),title:'Genuine '+c.slug,snapshot};
  for(const role of ['owner','admin','member']){const result=await post(users[role],{...payload,requestId:randomUUID(),title:role+' '+c.slug});assert.equal(result.status,201,JSON.stringify(result));const saved=await ok(users[role].sdk.from('technology_next_shared_snapshots').select('*').eq('id',result.body.id).single());assert.deepEqual(saved.input_data,input);assert.deepEqual(saved.output_data,output);assert.equal(saved.calculator_version,1);assert.equal(saved.project_id,project.id);assert.equal(saved.client_workspace_id,client.id);rows.push({catalogId:c.catalogId,role,id:saved.id,href:result.body.href,snapshot});}
  const first=await post(users.owner,payload),retry=await post(users.owner,payload);assert.equal(first.status,201);assert.equal(retry.body.id,first.body.id);assert.equal((await post(users.owner,{...payload,title:'conflict'})).status,409);assert.equal(await db.sql(`SELECT count(*) FROM public.organization_audit_log WHERE entity_id='${first.body.id}';`),'1');
  for(const role of ['viewer','foreign'])assert.equal((await post(users[role],{...payload,requestId:randomUUID()})).status,403);
  assert.equal((await post(users.owner,{...payload,requestId:randomUUID(),snapshot:{...snapshot,calculatorVersion:2}})).status,422);
  const row=rows.find(r=>r.catalogId===c.catalogId&&r.role==='owner');
  for(const role of ['owner','admin','member','viewer']){
   const raw=cookie(users[role]),i=raw.indexOf('=');await browser.identity({name:raw.slice(0,i),value:raw.slice(i+1)});await visit(row.href);await browser.until(enabled('Verify exact engine agreement'));await trustedClick('Verify exact engine agreement');await browser.until('document.body.innerText.includes("Exact engine agreement verified")');
   for(const type of role==='owner'?['JSON','CSV','PDF']:['JSON']){const ext=type.toLowerCase(),d=await recordedDownload(downloadBrowser,{label:'Export recorded '+type,filename:c.slug+'-v1.'+ext,directory:directory+'/downloads'});if(type==='JSON')assert.deepEqual(JSON.parse(d.bytes),snapshot);if(type==='CSV')assert(d.bytes.toString().includes('"output","value","'+c.expected+'"'));if(type==='PDF'){const text=execFileSync('pdftotext',['-layout','-','-'],{input:d.bytes,encoding:'utf8',timeout:10000});assert.deepEqual([...text.matchAll(/^\s*output\["value"\]\s*=\s*([^\r\n]+)\s*$/gm)].map(m=>m[1].trim()),[String(c.expected)]);}downloads.push({catalogId:c.catalogId,role,type,file:path.relative(directory,d.file),bytes:d.bytes.length,sha256:sha(d.bytes),events:d.events.map(e=>Object.fromEntries(Object.entries(e).filter(([k])=>k!=='url')))});}
  }
  const personal=JSON.parse(await readFile(path.join(artifacts,'personal/receipt.json'),'utf8')),download=personal.downloads.find(d=>d.tag==='business:'+c.catalogId+':local-scenarios');assert(download);
  const localSet=JSON.parse(await readFile(path.join(artifacts,'personal',download.file),'utf8')),b=localSet.scenarios.find(s=>s.slot==='B'),alternate={...snapshot,input:b.input,output:b.output};assert.notEqual(alternate.output.value,snapshot.output.value);
  const alt=await post(users.owner,{...payload,requestId:randomUUID(),title:'Alternate '+c.slug,snapshot:alternate});assert.equal(alt.status,201,JSON.stringify(alt));
  const raw=cookie(users.owner),at=raw.indexOf('=');await browser.identity({name:raw.slice(0,at),value:raw.slice(at+1)});await visit('/business/projects/'+project.id+'?cohort=next');await browser.until(`!!document.querySelector('[aria-label="Shared record for comparison"]')`);
  const key=async(key,code,n)=>{for(const type of ['keyDown','keyUp'])await browser.send('Input.dispatchKeyEvent',{type,key,code,windowsVirtualKeyCode:n,...(key==='Enter'&&type==='keyDown'?{text:'\r',unmodifiedText:'\r'}:{})});};
  const chooseSelect=async(label,value)=>{const selector='[aria-label="'+label+'"]';await browser.until(`!!document.querySelector(${JSON.stringify(selector)})&&Object.keys(document.querySelector(${JSON.stringify(selector)})).some(k=>k.startsWith('__reactProps$'))`);const i=await browser.js(`(()=>{const e=document.querySelector(${JSON.stringify(selector)});e.focus();return [...e.options].findIndex(o=>o.value===${JSON.stringify(value)})})()`);assert(i>=0);await key('Home','Home',36);for(let n=0;n<i;n++)await key('ArrowDown','ArrowDown',40);await key('Tab','Tab',9);await browser.until(`document.querySelector(${JSON.stringify(selector)}).value===${JSON.stringify(value)}`);};
  const button=async label=>{await browser.until(`(()=>{const e=[...document.querySelectorAll('button')].find(e=>e.textContent.trim()===${JSON.stringify(label)});if(!e||e.disabled||!e.getClientRects().length||!Object.keys(e).some(k=>k.startsWith('__reactProps$')))return false;e.focus();return document.hasFocus()&&document.activeElement===e&&!document.body.innerText.includes('Verifying account session')})()`);await key('Enter','Enter',13);};
  const reveal=async label=>{await browser.until(`[...document.querySelectorAll('summary')].some(e=>e.textContent.trim()===${JSON.stringify(label)}&&Object.keys(e).some(k=>k.startsWith('__reactProps$')))`);const info=await browser.js(`(()=>{const e=[...document.querySelectorAll('summary')].find(e=>e.textContent.trim()===${JSON.stringify(label)});if(e.parentElement.open)return null;e.scrollIntoView({behavior:'instant',block:'center'});const r=e.getClientRects()[0];return{x:r.x+r.width/2,y:r.y+r.height/2}})()`);if(info)for(const type of ['mousePressed','mouseReleased'])await browser.send('Input.dispatchMouseEvent',{type,button:'left',clickCount:1,...info});await browser.until(`[...document.querySelectorAll('summary')].find(e=>e.textContent.trim()===${JSON.stringify(label)}).parentElement.open`);};
  await browser.js(`window.__parallelCaptures=[];for(const type of ['keydown','click'])document.addEventListener(type,e=>{if(e.target.tagName==='BUTTON'&&['Capture baseline A','Capture scenario B'].includes(e.target.textContent))window.__parallelCaptures.push({type,trusted:e.isTrusted,key:e.key,label:e.target.textContent})},true)`);
  await chooseSelect('Shared calculator for comparison',c.slug+'@1');await chooseSelect('Shared record for comparison',row.id);await reveal('Your A/B/C scenarios');await button('Capture baseline A');await browser.until('document.body.innerText.includes("Captured baseline A from the current calculation.")');await chooseSelect('Shared record for comparison',alt.body.id);await button('Capture scenario B');await browser.until('document.body.innerText.includes("Captured scenario B from the current calculation.")');
  const get=async(label,filename)=>{const d=await recordedDownload(downloadBrowser,{label,filename,directory:directory+'/downloads'});downloads.push({catalogId:c.catalogId,role:'owner',type:label,file:path.relative(directory,d.file),bytes:d.bytes.length,sha256:sha(d.bytes),events:d.events.map(e=>Object.fromEntries(Object.entries(e).filter(([k])=>k!=='url')))});return d.bytes;};
  const set=JSON.parse(await get('Export scenario set JSON',c.slug+'-scenarios.json'));assert.deepEqual(set.scenarios.map(s=>({slot:s.slot,input:s.input,output:s.output})),[{slot:'A',input:snapshot.input,output:snapshot.output},{slot:'B',input:alternate.input,output:alternate.output}]);await browser.click('Clear scenario set');await reveal('Recover an exported scenario set');await browser.field('.scenario-recovery textarea',JSON.stringify(set));await browser.click('Verify and recover scenario set');await browser.until('document.body.innerText.includes("Recovered 2 verified scenarios as a separate working set.")');
  const tampered=structuredClone(set);tampered.scenarios[0].output.value+=1;await browser.field('.scenario-recovery textarea',JSON.stringify(tampered));await browser.click('Verify and recover scenario set');await browser.until('document.body.innerText.includes("Recovery unavailable:")');assert.deepEqual(JSON.parse(await get('Export scenario set JSON',c.slug+'-scenarios.json')),set);
  for(const type of ['JSON','CSV','PDF']){const bytes=await get('Export scenario report '+type,c.slug+'-scenario-report.'+type.toLowerCase());if(type==='JSON'){const report=JSON.parse(bytes);assert.equal(report.calculatorSlug,c.slug);assert.equal(report.calculatorVersion,1);assert.deepEqual(report.scenarios,set.scenarios);assert.equal(report.comparison.metrics.find(m=>m.field==='value').cells[1].difference,alternate.output.value-snapshot.output.value);}if(type==='PDF')assert(bytes.subarray(0,8).toString().startsWith('%PDF-1.7'));}
  const captureEvents=await browser.js('window.__parallelCaptures');assert.equal(captureEvents.filter(e=>e.type==='click'&&e.trusted).length,2);comparisons.push({captureEvents,catalogId:c.catalogId,aId:row.id,bId:alt.body.id,a:snapshot,b:alternate,recovered:true,tamperRefused:true,scenarioReports:['JSON','CSV','PDF']});
  checks.push(c.catalogId+' owner/admin/member persisted immutable project/client snapshot; viewer/foreign writes denied; idempotent audit; four-role exact replay and disk exports');pass(checks.at(-1));
  await writeFile(directory+'/checkpoint.json',JSON.stringify({passed:true,scope:'COMPLETED_SHARING_JOURNEYS_ONLY',sourceHashes,rows,downloads,comparisons,checks},null,2)+'\n');
 }
 assert.deepEqual(await ok(users.foreign.sdk.from('technology_next_shared_snapshots').select('id')),[]);
 await db.sql(`DELETE FROM public.organization_members WHERE organization_id='${org}' AND user_id='${users.member.id}';`);
 assert.deepEqual(await ok(users.member.sdk.from('technology_next_shared_snapshots').select('id')),[]);
 const sample=rows[0];assert.equal((await post(users.member,{organizationId:org,projectId:project.id,clientWorkspaceId:client.id,requestId:randomUUID(),title:'revoked',snapshot:sample.snapshot})).status,403);
 assert((await users.owner.sdk.rpc('share_technology_next_snapshot',{actor_id:users.owner.id,request_payload:{}})).error);assert((await users.member.sdk.from('technology_next_shared_snapshots').insert({organization_id:org})).error);
 const receipt={passed:true,producerSHA256:sha(await readFile(new URL(import.meta.url))),sourceHashes,rows,downloads,comparisons,checks,foreignRLS:true,revokedMemberReadAndWriteDenied:true,directAuthenticatedRPCAndInsertDenied:true,productionWrites:false,certificationGranted:false,releaseHold:true};await writeFile(directory+'/receipt.json',JSON.stringify(receipt,null,2)+'\n');return receipt;
}
