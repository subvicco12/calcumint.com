try{
 await build({stdin:{contents:"export {storeTechnologyNextShare} from './src/lib/business/technology-next-sharing-server';export {calculatorRegistry} from './src/calculators/registry';export {runCalculator} from './src/calculators/engine';export {saveHistoryAtomically} from './src/lib/account-persistence';export {technologyNextCatalog} from './src/lib/native-delivery/technology-next-catalog';",resolveDir:process.cwd(),loader:'ts'},outfile:tmp+'/adapter.mjs',bundle:true,platform:'node',format:'esm',plugins:[{name:'genuine-sdk-transport-only',setup(b){b.onResolve({filter:/^@\/lib\/supabase\/(server|admin)$/},args=>({path:args.path,namespace:'actual-sdk'}));b.onLoad({filter:/.*/,namespace:'actual-sdk'},args=>({contents:args.path.endsWith('/server')?'export async function createSupabaseServerClient(){return globalThis.__sharingUserSdk}':'export function createSupabaseAdminClient(){return globalThis.__sharingServiceSdk}',loader:'js'}));}}]});
 const app=await import(tmp+'/adapter.mjs');db=await startGoTrueFixture({initializeSchema:initializeFullSchema});
