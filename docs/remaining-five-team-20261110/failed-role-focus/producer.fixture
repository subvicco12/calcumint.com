 next=await startNextRuntime({root:process.cwd(),auth:{url:db.url},db,artifacts:directory});for(const p of sources.filter(p=>p.startsWith('src/'))){copiedSourceHashes[p]=hash(await readFile(path.join(next.dir,p)));assert.equal(copiedSourceHashes[p],sourceHashes[p]);}
 browser=await startBrowser(next.url,[db.url]);await browser.send('Emulation.setDeviceMetricsOverride',{width:360,height:1000,deviceScaleFactor:1,mobile:true});
 const cookie=user=>({name:'sb-127-auth-token',value:'base64-'+Buffer.from(JSON.stringify(user.session)).toString('base64url')});
 const visit=async p=>{await browser.send('Page.navigate',{url:next.url+p});await browser.until('document.readyState==="complete"');};
 const enabled=s=>`[...document.querySelectorAll('button')].some(b=>b.textContent.trim()===${JSON.stringify(s)}&&!b.disabled&&b.getClientRects().length)`;
 const download=async(label,snapshot,tag)=>{const ext=label.split(' ').at(-1).toLowerCase(),d=await recordedDownload(browser,{label,filename:snapshot.calculatorSlug+'-v'+snapshot.calculatorVersion+'.'+ext,directory:directory+'/downloads'});if(ext==='json')assert.deepEqual(JSON.parse(d.bytes),snapshot);if(ext==='csv'){const lines=d.bytes.toString().split(/\r?\n/);for(const line of ['"identity","calculatorSlug","'+snapshot.calculatorSlug+'"','"identity","calculatorVersion","'+snapshot.calculatorVersion+'"','"output","value","'+snapshot.output.value+'"'])assert(lines.includes(line));}if(ext==='pdf'){const text=execFileSync('pdftotext',['-layout','-','-'],{input:d.bytes,encoding:'utf8',timeout:10000});assert.deepEqual([...text.matchAll(/^\s*output\["value"\]\s*=\s*([^\r\n]+)\s*$/gm)].map(m=>m[1].trim()),[String(snapshot.output.value)]);assert.deepEqual([...text.matchAll(/Engine\s+version:\s*(\d+)\s*$/gm)].map(m=>Number(m[1])),[snapshot.calculatorVersion]);}exports.push({tag,file:path.relative(directory,d.file),filename:d.filename,bytes:d.bytes.length,sha256:hash(d.bytes),events:d.events.map(event=>Object.fromEntries(Object.entries(event).filter(([k])=>k!=='url')))});};
 const native=rows.map(({snapshot,id})=>({snapshot,href:'/business/shared/'+id+'?cohort=next'}));
 for(const name of ['admin','member','viewer']){await browser.identity(cookie(users[name]));for(const row of native){await visit(row.href);await browser.until(enabled('Verify exact engine agreement'));await browser.click('Verify exact engine agreement');await browser.until(`document.body.innerText.includes('Exact engine agreement verified')`);await download('Export recorded JSON',row.snapshot,name+':'+row.snapshot.calculatorSlug);roleJourneys.push({role:name,slug:row.snapshot.calculatorSlug,version:row.snapshot.calculatorVersion,read:true,exactReplay:true,nativeJsonExport:true});}await visit('/business/projects/'+project.id+'?cohort=next');await browser.until(`document.body.innerText.includes('Current role: ${name}')`);assert.equal(await browser.js(enabled('Share verified snapshot')),name!=='viewer');}
 await writeFile(directory+'/role-phase.json',JSON.stringify({passed:true,scope:'GENUINE_ROLE_READ_EXPORT_ONLY_NOT_NEGATIVE_TAIL_COMPLETE',testedBaseline,sourceHashes,copiedSourceHashes,roleJourneys,exports},null,2)+'\n');
 pass('Genuine Admin/Member/Viewer read and native JSON export every remaining snapshot; Viewer UI write refusal');
 for(const plan of ['free','pro']){await db.sql(`UPDATE public.profiles SET plan='${plan}' WHERE id='${users.member.id}';`);await browser.identity(cookie(users.member));for(const row of native){await visit(row.href);await browser.until(`document.body.innerText.includes('Shared snapshot unavailable')&&document.body.innerText.includes('Business workspace access is required.')`);assert.equal(await browser.js(`!!document.querySelector(${JSON.stringify('[aria-label="Saved calculation tools"]')})`),false);roleJourneys.push({role:'member',plan,slug:row.snapshot.calculatorSlug,version:row.snapshot.calculatorVersion,readDenied:true});}}await db.sql(`UPDATE public.profiles SET plan='business' WHERE id='${users.member.id}';`);pass('Every remaining genuine Free and Pro account page denies shared data and private tools');
 await browser.identity(cookie(users.foreign));for(const row of native){await visit(row.href);await browser.until(`document.body.innerText.includes('Shared snapshot unavailable')`);assert.equal(await browser.js(`!!document.querySelector(${JSON.stringify('[aria-label="Saved calculation tools"]')})`),false);}pass('Foreign genuine account denied every actual shared-record page');
 await db.sql(`DELETE FROM public.organization_members WHERE organization_id='${org}' AND user_id='${users.member.id}';`);globalThis.__sharingUserSdk=users.member.sdk;for(const snapshot of snapshots)await assert.rejects(app.storeTechnologyNextShare(payload(snapshot)),e=>e.status===403);await browser.identity(cookie(users.member));for(const row of native){await visit(row.href);await browser.until(`document.body.innerText.includes('Shared snapshot unavailable')`);}pass('Membership revocation refuses new reads/shares for all remaining five; prior exported files are not retroactively revoked');
 for(const record of history){const saved=await ok(users.owner.sdk.from('calculation_history').select('*').eq('id',record.id).single());assert.equal(saved.calculator_version,record.snapshot.calculatorVersion);assert.deepEqual(saved.input_data,record.snapshot.input);assert.deepEqual(saved.output_data,record.snapshot.output);}for(const row of rows){const saved=await ok(users.owner.sdk.from('technology_next_shared_snapshots').select('*').eq('id',row.id).single());assert.deepEqual(saved.input_data,row.snapshot.input);assert.deepEqual(saved.output_data,row.snapshot.output);}pass('All five original personal history and shared records preserve exact immutable version/input/output after team workflows and permission changes');
 assert.deepEqual(browser.errors,[]);await writeFile(directory+'/receipt.json',JSON.stringify({passed:true,kind:'REMAINING_FIVE_GENUINE_ROLE_AND_NEGATIVE_TAIL_ONLY',testedBaseline,applicationBaseline:'3c9fc6bdcedf053d2315470f8c0ee549d53bd5de',runtimeKind:'ACTUAL_NEXT_DEVELOPMENT_WEBPACK_NOT_PRODUCTION_BUILD',applicationSourceDiff:[],cases,history,roleJourneys,sourceHashes,copiedSourceHashes,checks,rows:rows.map(({snapshot})=>({slug:snapshot.calculatorSlug,version:snapshot.calculatorVersion,input:snapshot.input,output:snapshot.output})),native:native.map(({snapshot,href})=>({slug:snapshot.calculatorSlug,version:snapshot.calculatorVersion,href})),exports,fixture:db.provenance,requests:db.requests,limits:['New guarded SQL adopted ONLY in disposable candidate repository fixture; no held integrity repair adoption or production equivalence','Server-only trusted service-role RPC; authenticated clients cannot submit direct storage writes','Actor and organization owner both retain existing Business entitlement checks; no commercial seat policy change','Membership enforced on each read/share; no live push revocation or retroactive recall of exported bytes','Client categorization is an authenticated team workspace relation, not a public client portal or delivered-email assertion','Existing calculation revisions/history and old shared table/RLS remain unchanged','No canonical/source/specialist/publication approval']},null,2)+'\n');
}catch(e){await writeFile(directory+'/failure.txt',e.stack);if(browser)try{await writeFile(directory+'/failure-page.txt',await browser.text());}catch{}throw e;}finally{await browser?.close();await next?.close();await db?.close();await rm(tmp,{recursive:true,force:true});delete globalThis.__sharingUserSdk;delete globalThis.__sharingServiceSdk;}
