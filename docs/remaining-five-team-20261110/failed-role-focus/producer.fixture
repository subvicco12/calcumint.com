 {catalogId:385,slug:'cloud-data-transfer-cost-calculator',version:1,input:{transferGb:500,pricePerGb:0.09},expected:45,alternate:90,scope:'Supplied currency units per transfer; no inferred recurring period/provider/tier'}
 ];
 const snapshots=cases.map(c=>{const d=app.calculatorRegistry.getBySlug(c.slug);assert.equal(d.version,c.version);const output=app.runCalculator(d,c.input).output;assert.equal(output.value,c.expected);return{calculatorSlug:c.slug,calculatorVersion:c.version,input:c.input,output};});
 const payload=snapshot=>({organizationId:org,projectId:project.id,clientWorkspaceId:client.id,requestId:randomUUID(),title:'Shared '+snapshot.calculatorSlug,snapshot});
 const deadline=Date.now()+10000;for(;;){const result=await users.owner.sdk.rpc('technology_next_sharing_capability',{target_org:org});if(!result.error){assert.equal(result.data,'technology-next-sharing-private-1');break;}if(result.error.code!=='PGRST202'||Date.now()>deadline)assert.fail(JSON.stringify(result.error));await new Promise(r=>setTimeout(r,100));}
 globalThis.__sharingUserSdk=users.owner.sdk;
 for(const snapshot of snapshots){const request=payload(snapshot);const ids=await Promise.all([app.storeTechnologyNextShare(request),app.storeTechnologyNextShare(request)]);assert.equal(ids[0],ids[1]);await assert.rejects(app.storeTechnologyNextShare({...request,title:'Conflicting retry'}),e=>e.status===409);const saved=await ok(users.owner.sdk.from('technology_next_shared_snapshots').select('*').eq('id',ids[0]).single());assert.deepEqual(saved.input_data,snapshot.input);assert.deepEqual(saved.output_data,snapshot.output);assert.equal(saved.client_workspace_id,client.id);assert.equal(await db.sql(`SELECT count(*) FROM public.organization_audit_log WHERE entity_id='${ids[0]}';`),'1');rows.push({snapshot,id:ids[0]});}
 pass('Remaining five exact snapshots: genuine SDK/server verifier -> service-only atomic RPC, concurrent idempotency and one audit each');
