const sources=['src/lib/business/technology-next-sharing.ts','src/lib/business/technology-next-sharing-server.ts','src/components/technology-five-share-form.tsx','src/app/api/business/technology-five-shares/route.ts','src/app/business/projects/[id]/page.tsx','src/app/business/shared/[id]/page.tsx','src/app/business/page.tsx','src/app/business/api/page.tsx','src/components/saved-calculation-actions.tsx','src/components/account-session-boundary.tsx','docs/next-cohort-sharing-20261110/review-only-sharing.sql','tests/remaining-five-team-20261110/role-tail.mjs','src/components/technology-five-shared-comparison.tsx','src/components/calculator-scenario-workspace.tsx','src/components/scenario-set-recovery.tsx','src/lib/scenario-report.ts','src/lib/scenario-report-pdf.ts','src/lib/draft-history-pagination.ts','src/lib/storage-scenario-context.ts','src/lib/scenario-set-recovery.ts','src/lib/technology-next-capture-trust.ts','src/lib/native-delivery/technology-next-catalog.ts','src/lib/technology-current-presentation.ts','src/calculators/technology-computing/catalog-batch-1.ts','src/calculators/technology-computing/catalog-batch-2.ts','src/lib/registered-snapshot-verification.ts','src/lib/technology-snapshot-verification.ts','src/lib/account-persistence.ts'];
