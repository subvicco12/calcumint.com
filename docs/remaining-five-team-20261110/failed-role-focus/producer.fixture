 for(const name of ['admin','member']){globalThis.__sharingUserSdk=users[name].sdk;for(const snapshot of snapshots){const id=await app.storeTechnologyNextShare({...payload(snapshot),title:name+' positive '+snapshot.calculatorSlug});assert.equal(typeof id,'string');}}globalThis.__sharingUserSdk=users.viewer.sdk;for(const snapshot of snapshots){await assert.rejects(app.storeTechnologyNextShare(payload(snapshot)),e=>e.status===403);assert((await globalThis.__sharingServiceSdk.rpc('share_technology_next_snapshot',{actor_id:users.viewer.id,request_payload:payload(snapshot)})).error);}globalThis.__sharingUserSdk=users.owner.sdk;
 for(const snapshot of snapshots){await assert.rejects(app.storeTechnologyNextShare({...payload(snapshot),projectId:foreignProject.id}),e=>e.status===404);await assert.rejects(app.storeTechnologyNextShare({...payload(snapshot),clientWorkspaceId:foreignClient.id}),e=>e.status===409);}const website=snapshots.find(s=>s.calculatorSlug==='website-bandwidth-calculator');await assert.rejects(app.storeTechnologyNextShare(payload({...website,calculatorVersion:1})),e=>e.status===422);pass('Every remaining identity: Admin/Member positive, Viewer write refusal, foreign project/client refusal; website historical v1 explicitly rejected');
