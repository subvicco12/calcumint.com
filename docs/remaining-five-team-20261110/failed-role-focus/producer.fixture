 const guard=/DO \$sharing_guard\$ BEGIN RAISE EXCEPTION 'UNAPPLIED_TECHNOLOGY_NEXT_SHARING_PRIVATE_1'; END \$sharing_guard\$;/;assert.match(proposal,guard);await db.sql(proposal.replace(guard,'-- Adopted ONLY in this disposable fixture.'));
 globalThis.__sharingServiceSdk=createClient(db.url,db.serviceKey,{auth:{persistSession:false,autoRefreshToken:false}});
 const users={};for(const name of ['owner','admin','member','viewer','foreign']){const sdk=createClient(db.url,db.anonKey,{auth:{persistSession:false,autoRefreshToken:false,detectSessionInUrl:false}});const data=await ok(sdk.auth.signUp({email:name+'-'+randomUUID()+'@example.invalid',password:'Local-'+randomUUID()}));await db.sql(`UPDATE public.profiles SET plan='business' WHERE id='${data.user.id}';`);users[name]={sdk,id:data.user.id,session:data.session};}
 const org=await ok(users.owner.sdk.rpc('create_business_organization',{org_name:'Remaining five shared work',org_slug:'five-'+randomUUID()}));const foreignOrg=await ok(users.foreign.sdk.rpc('create_business_organization',{org_name:'Foreign work',org_slug:'foreign-'+randomUUID()}));
 await db.sql(`INSERT INTO public.organization_members(organization_id,user_id,role) VALUES('${org}','${users.admin.id}','admin'),('${org}','${users.member.id}','member'),('${org}','${users.viewer.id}','viewer');`);
