 for(const privilege of ['UPDATE','DELETE','TRUNCATE','TRIGGER','REFERENCES'])assert.equal(await db.sql(`SELECT has_table_privilege('service_role','public.technology_next_shared_snapshots','${privilege}');`),'f');
