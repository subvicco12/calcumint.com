 await assert.rejects(app.storeTechnologyNextShare({...payload(snapshots[0]),projectId:foreignProject.id}),e=>e.status===404);await assert.rejects(app.storeTechnologyNextShare({...payload(snapshots[0]),clientWorkspaceId:foreignClient.id}),e=>e.status===409);pass('Foreign organization project and client bindings rejected without adopting held integrity repair');
 assert((await globalThis.__sharingServiceSdk.rpc('share_technology_next_snapshot',{actor_id:users.owner.id,request_payload:{...payload(snapshots[0]),projectId:foreignProject.id}})).error);
 assert((await globalThis.__sharingServiceSdk.rpc('share_technology_next_snapshot',{actor_id:users.viewer.id,request_payload:payload(snapshots[0])})).error);
 await db.sql(`UPDATE public.profiles SET plan='free' WHERE id='${users.member.id}';`);assert((await globalThis.__sharingServiceSdk.rpc('share_technology_next_snapshot',{actor_id:users.member.id,request_payload:payload(snapshots[0])})).error);await db.sql(`UPDATE public.profiles SET plan='business' WHERE id='${users.member.id}';`);
 await db.sql(`UPDATE public.profiles SET plan='free' WHERE id='${users.owner.id}';`);assert.equal((await ok(users.viewer.sdk.rpc('technology_next_sharing_capability',{target_org:org}))),null);assert((await globalThis.__sharingServiceSdk.rpc('share_technology_next_snapshot',{actor_id:users.owner.id,request_payload:payload(snapshots[0])})).error);await db.sql(`UPDATE public.profiles SET plan='business' WHERE id='${users.owner.id}';`);pass('Atomic RPC independently rejects foreign projects/viewer actors/downgraded actors and owner plan; live read capability closes on owner downgrade');
 for(const plan of ['free','pro']){await db.sql(`UPDATE public.profiles SET plan='${plan}' WHERE id='${users.member.id}';`);globalThis.__sharingUserSdk=users.member.sdk;for(const snapshot of snapshots){await assert.rejects(app.storeTechnologyNextShare(payload(snapshot)),e=>e.status===403);assert((await globalThis.__sharingServiceSdk.rpc('share_technology_next_snapshot',{actor_id:users.member.id,request_payload:payload(snapshot)})).error);}}await db.sql(`UPDATE public.profiles SET plan='business' WHERE id='${users.member.id}';`);pass('Actual Free and Pro actor entitlement refusal for each remaining identity at server and atomic RPC boundaries');
 globalThis.__sharingUserSdk=users.viewer.sdk;await assert.rejects(app.storeTechnologyNextShare(payload(snapshots[0])),e=>e.status===403);
